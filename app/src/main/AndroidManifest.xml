<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:label="@string/app_name" android:description="@string/module_description" android:allowBackup="false"
        android:icon="@drawable/ic_diagnostic" android:dataExtractionRules="@xml/data_extraction_rules"
        android:supportsRtl="true" android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <provider android:name=".FeatureProvider" android:authorities="dev.cheeseowl.gmbg.flags"
            android:exported="true" android:grantUriPermissions="false" />
        <activity android:name=".InfoActivity" android:exported="true" android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="de.robv.android.xposed.category.MODULE_SETTINGS" />
                <category android:name="android.intent.category.INFO" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity-alias android:name=".LauncherAlias" android:targetActivity=".InfoActivity"
            android:enabled="true" android:exported="true" android:icon="@drawable/ic_diagnostic"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
